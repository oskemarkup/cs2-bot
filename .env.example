NODE_ENV=production
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=3000

POSTGRES_DB=cs2arb
POSTGRES_USER=cs2arb
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql://cs2arb:change_me@postgres:5432/cs2arb

# Required by the shared config package for legacy worker/API code paths.
# The scheduled collectors do not connect to Redis, and production compose does not start Redis.
REDIS_URL=redis://localhost:6379

SNAPSHOT_STORAGE_MODE=current_and_changes
RAW_SNAPSHOT_MODE=metadata_only
CURRENT_LAST_SEEN_UPDATE_INTERVAL_MINUTES=60
FORCE_FULL_HISTORY_EVERY_HOURS=24
DB_INSERT_BATCH_SIZE=250

RAW_SNAPSHOT_RETENTION_DAYS=7
HISTORY_SNAPSHOT_RETENTION_DAYS=30
COLLECTOR_RUN_RETENTION_DAYS=90
SIGNAL_SNAPSHOT_RETENTION_DAYS=30
TRADE_SIGNAL_RETENTION_DAYS=90

# Optional read-only marketplace API keys. Never commit real secrets.
MARKET_CSGO_API_KEY=

LIVE_MODE=false

# Market.CSGO signal strategy. SIGNAL_WATCHLIST is a comma-separated fallback
# when signal_watchlist has no enabled rows yet.
SIGNAL_WATCHLIST=
SIGNAL_LOOKBACK_HOURS=168
SIGNAL_ROLLING_WINDOW_HOURS=336
SIGNAL_MIN_HISTORY_POINTS=3
SIGNAL_MIN_BASELINE_ITEMS=3
SIGNAL_MIN_PRICE_MINOR=100
SIGNAL_MIN_SALES_COUNT=3
SIGNAL_BUY_RESIDUAL_BPS=800
SIGNAL_BUY_ZSCORE_BPS=10000
SIGNAL_SELL_RESIDUAL_BPS=600
SIGNAL_TAKE_PROFIT_BPS=1200
SIGNAL_MIN_EXPECTED_PROFIT_BPS=500
SIGNAL_BUY_FEE_BPS=0
SIGNAL_SELL_FEE_BPS=500
SIGNAL_SAFETY_MARGIN_BPS=200
SIGNAL_COOLDOWN_DAYS=8
SIGNAL_DEDUP_WINDOW_HOURS=12

# Telegram notifications for manual buy/sell review.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
