NODE_ENV=development
LOG_LEVEL=info

API_HOST=0.0.0.0
API_PORT=3000

DATABASE_URL=postgresql://cs2_bot:cs2_bot@localhost:5432/cs2_bot
REDIS_URL=redis://localhost:6379

# Development/test defaults preserve full append-only snapshots.
# Recommended production values:
# SNAPSHOT_STORAGE_MODE=current_and_changes
# RAW_SNAPSHOT_MODE=metadata_only
SNAPSHOT_STORAGE_MODE=full
RAW_SNAPSHOT_MODE=all
DB_INSERT_BATCH_SIZE=250
FORCE_FULL_HISTORY_EVERY_HOURS=24
CURRENT_LAST_SEEN_UPDATE_INTERVAL_MINUTES=60
RAW_SNAPSHOT_RETENTION_DAYS=7
HISTORY_SNAPSHOT_RETENTION_DAYS=30
COLLECTOR_RUN_RETENTION_DAYS=90

# Optional read-only marketplace API keys. Never commit real secrets.
MARKET_CSGO_API_KEY=
SKINPORT_API_KEY=
CSFLOAT_API_KEY=
DMARKET_API_KEY=

# Optional alert sink for manual review notifications.
ALERT_WEBHOOK_URL=
